{
  "name": "local-tools-canary",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "indexnow": "node scripts/submit-indexnow.mjs",
    "dev": "vinext dev",
    "prebuild": "npm run design:qc",
    "build": "vinext build && node scripts/prerender-to-assets.mjs && node scripts/verify-static-coverage.mjs && node scripts/verify-no-orphans.mjs && node scripts/verify-indexnow-key.mjs && node scripts/verify-built-headers.mjs && node scripts/check-share-and-heading-order.mjs && node scripts/build-service-worker-precache.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "node scripts/deploy-lock.mjs assert && wrangler deploy --config dist/server/wrangler.json",
    "lock": "node scripts/deploy-lock.mjs status",
    "lock:acquire": "node scripts/deploy-lock.mjs acquire",
    "lock:release": "node scripts/deploy-lock.mjs release",
    "board": "node scripts/board.mjs status",
    "board:sync": "node scripts/board.mjs sync",
    "board:append": "node scripts/board.mjs append",
    "lint": "oxlint",
    "format": "oxfmt app components lib workers scripts types proxy.ts next.config.ts vite.config.ts vitest.config.ts package.json tsconfig.json",
    "format:check": "oxfmt --check app components lib workers scripts types proxy.ts next.config.ts vite.config.ts vitest.config.ts package.json tsconfig.json",
    "portable": "node scripts/build-portable.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "test": "vitest run",
    "test:operations": "vitest run lib/tools/all-operations-qc.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "design:qc": "node scripts/design-system-qc.mjs",
    "predeploy": "node scripts/predeploy.mjs",
    "qc": "node scripts/run-qc.mjs",
    "qc:release": "node scripts/run-qc.mjs --release",
    "seo:guide-keep-list": "node scripts/guide-keep-list.mjs",
    "seo:guide-distinctness": "node scripts/guide-distinctness-report.mjs",
    "audit:live": "node scripts/audit-live-seo.mjs",
    "audit:360": "node scripts/audit-360.mjs",
    "sitemap:lastmod": "node scripts/build-sitemap-lastmod.mjs",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "libheif-js": "^1.23.2",
    "lucide-react": "1.31.0",
    "onnxruntime-web": "1.21.0",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "7.0.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.11",
    "@cloudflare/workers-types": "5.20260917.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "pdfjs-dist": "6.3.289",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.133.0"
  },
  "type": "module"
}
